SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Aislamiento entre workspaces ────────────────────────────────────────────────
#
# APP_WORKSPACE_MEMBERSHIP_ENFORCE (por defecto 1)
#   Exige pertenecer al workspace para leer y escribir en él. Dejarlo en 1.
#
# APP_SUPERADMIN_ENFORCE (por defecto 0)
#   Con 0 —el modo compatible— `workspace_session_is_privileged()` da paso libre a
#   cualquier sesión cuyo rol sea Administrador, Admin, Dirección, Control o
#   Administración, y esa vía se salta la pertenencia. Medido el 2026-08-09: 9 de
#   los 17 usuarios activos leen y escriben en los 4 workspaces, sean miembros o no.
#   Comprobado levantando el servidor: D.Garcia, miembro sólo de Modernia, modificó
#   una cita de DEMOCASA.
#
#   Con 1 sólo queda privilegiado quien esté en la allowlist de abajo, y cada
#   administrador se ciñe a sus workspaces. Antes de activarlo hay que comprobar que
#   nadie trabaja donde no consta:
#
#       python scripts/vincular_administradores_a_su_workspace.py          # informe
#       python scripts/vincular_administradores_a_su_workspace.py --apply
#
APP_WORKSPACE_MEMBERSHIP_ENFORCE=1
APP_SUPERADMIN_ENFORCE=0

# Quién conserva privilegios globales con APP_SUPERADMIN_ENFORCE=1.
# Si se deja vacío, el valor por defecto en el código es «Mperez».
APP_SUPERADMIN_USERNAMES=
APP_SUPERADMIN_EMAILS=
APP_SUPERADMIN_IDS=
